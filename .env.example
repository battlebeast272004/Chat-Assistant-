# Copy to .env and adjust. Load it with:  uvicorn main:app --env-file ../.env
# (.env is git-ignored; this template is not.)

# SQLite database location (default: <project>/data/assessments.db)
# ASSESSMENT_DB_PATH=C:/path/to/assessments.db

# Production widget endpoints, used to test each store's Content-Security-Policy.
# Leaving the placeholders makes CSP verdicts approximate (the report says so).
WIDGET_SCRIPT_URL=https://widget.shopping-assistant.example/v1/widget.js
WIDGET_API_ORIGIN=https://api.shopping-assistant.example
# Set only if the widget renders inside an iframe:
# WIDGET_FRAME_ORIGIN=https://frame.shopping-assistant.example

# Abuse / load limits
# Per client IP, across all assessment endpoints (0 disables):
ASSESSMENTS_PER_MINUTE=10
# Background assessments running at once:
MAX_CONCURRENT_JOBS=3
# Waiting jobs before /start returns 429:
MAX_QUEUED_JOBS=20
